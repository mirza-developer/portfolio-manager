@page "/logs/trades"
@inject ILogQueryService Logs
@inject IPortfolioService Portfolios
@inject IAssetAdminService Assets
@inject ICurrentUser CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Trade logs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <PageHeader Title="Trade logs" />

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="int?" Label="Portfolio" @bind-Value="_filter.PortfolioId" Clearable="true">
                    @foreach (var p in _portfolios) { <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="int?" Label="Asset" @bind-Value="_filter.AssetId" Clearable="true">
                    @foreach (var a in _assets) { <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.Symbol</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="TradeSide?" Label="Side" @bind-Value="_filter.Side" Clearable="true">
                    @foreach (var s in Enum.GetValues<TradeSide>()) { <MudSelectItem T="TradeSide?" Value="@((TradeSide?)s)">@s</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="TradeReason?" Label="Reason" @bind-Value="_filter.Reason" Clearable="true">
                    @foreach (var r in Enum.GetValues<TradeReason>()) { <MudSelectItem T="TradeReason?" Value="@((TradeReason?)r)">@r</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2"><MudDatePicker Label="From" @bind-Date="_from" Clearable="true" /></MudItem>
            <MudItem xs="12" sm="6" md="2"><MudDatePicker Label="To" @bind-Date="_to" Clearable="true" /></MudItem>
        </MudGrid>
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyAsync">Apply filters</MudButton>
    </MudPaper>

    <MudTable T="TradeLogRow" @ref="_table" ServerData="LoadAsync" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Time</MudTh><MudTh>Portfolio</MudTh><MudTh>Asset</MudTh><MudTh>Side</MudTh><MudTh>Reason</MudTh>
            <MudTh>Quantity</MudTh><MudTh>Price</MudTh><MudTh>Value</MudTh><MudTh>Fee</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.TimestampUtc.ToLocalTime().ToString("g")</MudTd>
            <MudTd>@context.PortfolioName</MudTd>
            <MudTd>@context.Symbol</MudTd>
            <MudTd>@context.Side</MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd>@context.Quantity</MudTd>
            <MudTd><MoneyText Value="context.PriceUsdt" Decimals="4" /></MudTd>
            <MudTd><MoneyText Value="context.ValueUsdt" /></MudTd>
            <MudTd><MoneyText Value="context.FeeUsdt" Decimals="4" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No trades match the filters.</MudText></NoRecordsContent>
        <LoadingContent><MudProgressLinear Indeterminate="true" /></LoadingContent>
        <PagerContent><MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<TradeLogRow>? _table;
    private UserContext? _user;
    private readonly TradeLogFilter _filter = new();
    private IReadOnlyList<PortfolioSummary> _portfolios = Array.Empty<PortfolioSummary>();
    private IReadOnlyList<Asset> _assets = Array.Empty<Asset>();
    private DateTime? _from, _to;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        try
        {
            _portfolios = await Portfolios.ListAsync(_user);
            _assets = await Assets.ListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Error(ex);
        }
    }

    private async Task<TableData<TradeLogRow>> LoadAsync(TableState state, CancellationToken ct)
    {
        try
        {
            _filter.FromUtc = _from?.Date.ToUniversalTime();
            _filter.ToUtc = _to?.Date.AddDays(1).ToUniversalTime();   // exclusive end: the whole picked day is included
            var page = await Logs.GetTradeLogsAsync(_user ?? await CurrentUser.GetAsync(), _filter, state.Page, state.PageSize, ct);
            return new TableData<TradeLogRow> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Error(ex);
            return new TableData<TradeLogRow> { Items = Array.Empty<TradeLogRow>(), TotalItems = 0 };
        }
    }

    private Task ApplyAsync() => _table is null ? Task.CompletedTask : _table.ReloadServerData();
}
